{
    "workbench.colorTheme": "Quiet Dark",
    "workbench.colorCustomizations": {
        "window.activeBorder": "#68aace",
        "window.inactiveBorder": "#a93535",
        "panel.border": "#4a3333",
        "sideBar.border": "#5a5959",
        "sideBarSectionHeader.border": "#474343",
        "editorLineNumber.foreground": "#c75381",
        "editorLineNumber.activeForeground": "#cdc43f",
        "editor.lineHighlightBackground": "#00000000",
        "editor.lineHighlightBorder": "#403d65"
    },
    "go.lintOnSave": "package",
    "go.lintTool": "golangci-lint",
    "go.lintFlags": [
        "--fast",
        "-c",
        "/Users/piotrpersona//developer/.golangci.yaml"
    ],
    "editor.formatOnSave": true,
    "go.testTimeout": "1m",
    "go.useLanguageServer": true,
    "gopls": {
        "formatting.gofumpt": true,
    },
    "go.toolsManagement.autoUpdate": true,
    "[javascript]": {
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.tabSize": 2
    },
    "[vue]": {
        "editor.tabSize": 2
    },
    "[vue-html]": {
        "editor.tabSize": 2
    },
    "[tailwindcss]": {
        "editor.tabSize": 2
    },
    "[javascriptreact]": {
        "editor.tabSize": 2
    },
    "[typescript]": {
        "editor.tabSize": 2,
    },
    "[astro]": {
        "editor.tabSize": 2,
    },
    "security.workspace.trust.untrustedFiles": "open",
    "terminal.integrated.scrollback": 5000,
    "workbench.preferredDarkColorTheme": "Community Material Theme Ocean High Contrast",
    "workbench.preferredHighContrastLightColorTheme": "Brackets Light Pro",
    "workbench.preferredLightColorTheme": "Ayu Mirage Bordered",
    "window.autoDetectColorScheme": true,
    "[python]": {
        "editor.formatOnType": true
    },
    "editor.lineNumbers": "relative",
    "javascript.updateImportsOnFileMove.enabled": "never",
    "workbench.iconTheme": "material-icon-theme"
}
